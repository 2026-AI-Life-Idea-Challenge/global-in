    {
        "policy_id": "L1-18",
        "topic": "blanket_l_visa_application",
        "visa_classifications": ["L-1A", "L-1B"],
        "applies_when": "included_in_approved_blanket_l_petition",
        "form_i129s_required_at_interview": true,
        "fraud_prevention_and_detection_fee_required": true,
        "border_security_act_fee_conditionally_applicable": true,
        "fraud_prevention_fee_amount_verified": false,
        "border_security_act_fee_amount_verified": false,
        "summary_ko": "Blanket L 청원에 포함된 비자 신청자는 인터뷰 시 Form I-129S를 지참해야 하며, Fraud Prevention and Detection 수수료가 추가로 적용된다. Border Security Act 수수료는 해당 조건을 충족하는 경우 적용될 수 있다.",
        "source_ids": ["DOS-TEMP-WORKER"],
        "review_status": "needs_review"
    },
    {
