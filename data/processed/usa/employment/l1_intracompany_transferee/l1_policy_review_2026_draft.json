  "policy_records": [
    {
      "policy_id": "L1-01",
      "topic": "qualifying_corporate_relationship",
      "visa_classifications": ["L-1A", "L-1B"],
      "qualifying_relationship_types": [
        "parent",
        "branch",
        "subsidiary",
        "affiliate"
      ],
      "summary_ko": "미국 고용주와 해외 기업 간에 모회사, 지점, 자회사 또는 계열사 등의 적격 관계가 있어야 한다.",
      "source_ids": ["USCIS-L1A", "USCIS-L1B"],
      "review_status": "needs_review"
    },
    {
      "policy_id": "L1-02",
      "topic": "business_operations",
      "visa_classifications": ["L-1A", "L-1B"],
      "summary_ko": "적격 기업은 미국과 미국 외 최소 한 국가에서 고용주로서 사업을 운영하고 있거나 운영할 예정이어야 한다.",
      "source_ids": ["USCIS-L1A", "USCIS-L1B"],
      "review_status": "needs_review"
    },
    {
      "policy_id": "L1-03",
      "topic": "prior_foreign_employment",
      "visa_classifications": ["L-1A", "L-1B"],
      "foreign_employment_continuous_years": 1,
      "lookback_period_years": 3,
      "general_rule_with_possible_exceptions": true,
      "summary_ko": "일반적으로 미국 입국 직전 3년 중 해외 적격 기업에서 연속 1년 근무한 경력이 필요하다. 예외 적용 가능성은 별도 검수한다.",
      "source_ids": ["USCIS-L1A", "USCIS-L1B"],
      "review_status": "needs_review"
    },
    {
      "policy_id": "L1-04",
      "topic": "l1a_executive_capacity",
      "visa_classifications": ["L-1A"],
      "summary_ko": "임원 직무는 일반적으로 많은 감독 없이 폭넓은 재량으로 의사결정을 내릴 수 있는 역할을 의미한다.",
      "source_ids": ["USCIS-L1A"],
      "review_status": "needs_review"
    },
    {
      "policy_id": "L1-05",
      "topic": "l1a_managerial_capacity",
      "visa_classifications": ["L-1A"],
      "summary_ko": "관리자 직무에는 전문직 직원 및 조직·부서·기능 관리가 포함된다. 중요한 조직 기능을 높은 수준에서 관리하는 경우도 포함될 수 있다.",
      "source_ids": ["USCIS-L1A"],
      "review_status": "needs_review"
    },
    {
      "policy_id": "L1-06",
      "topic": "l1b_specialized_knowledge",
      "visa_classifications": ["L-1B"],
      "knowledge_categories": [
        "special_knowledge",
        "advanced_knowledge"
      ],
      "categories_are_alternatives": true,
      "summary_ko": "신청 기업의 제품·서비스·연구·장비·기술 등에 관한 특수지식 또는 조직의 프로세스·절차에 관한 고급 지식이나 전문성이 요구된다.",
      "source_ids": ["USCIS-L1B"],
      "review_status": "needs_review"
    },
    {
      "policy_id": "L1-07",
      "topic": "initial_stay_new_office",
      "visa_classifications": ["L-1A", "L-1B"],
      "maximum_initial_stay_years": 1,
      "summary_ko": "미국 신규 사무소를 설립하기 위해 입국하는 적격 직원의 최초 체류기간은 최대 1년이다.",
      "source_ids": ["USCIS-L1A", "USCIS-L1B"],
      "review_status": "needs_review"
    },
    {
      "policy_id": "L1-08",
      "topic": "initial_stay_other",
      "visa_classifications": ["L-1A", "L-1B"],
      "maximum_initial_stay_years": 3,
      "summary_ko": "신규 사무소 설립에 해당하지 않는 적격 직원의 최초 체류기간은 최대 3년이다.",
      "source_ids": ["USCIS-L1A", "USCIS-L1B"],
      "review_status": "needs_review"
    },
    {
      "policy_id": "L1-09",
      "topic": "l1a_extension_and_maximum_stay",
      "visa_classifications": ["L-1A"],
      "maximum_extension_increment_years": 2,
      "maximum_stay_years": 7,
      "summary_ko": "L-1A 체류기간 연장은 최대 2년 단위로 허가될 수 있으며 일반적인 최대 체류기간은 7년이다.",
      "source_ids": ["USCIS-L1A"],
      "review_status": "needs_review"
    },
    {
      "policy_id": "L1-10",
      "topic": "l1b_extension_and_maximum_stay",
      "visa_classifications": ["L-1B"],
      "maximum_extension_increment_years": 2,
      "maximum_stay_years": 5,
      "summary_ko": "L-1B 체류기간 연장은 최대 2년 단위로 허가될 수 있으며 일반적인 최대 체류기간은 5년이다.",
      "source_ids": ["USCIS-L1B"],
      "review_status": "needs_review"
    },
    {
        "policy_id": "L1-11",
        "topic": "l1a_new_office_requirements",
        "visa_classifications": ["L-1A"],
        "applicant_type": "executive_or_manager",
        "sufficient_physical_premises_required": true,
        "prior_executive_or_manager_employment_years": 1,
        "prior_employment_lookback_years": 3,
        "us_office_support_position_within_years": 1,
        "summary_ko": "L-1A 신규 사무소 설립을 위해서는 충분한 물리적 사무 공간을 확보하고, 직원이 청원 제출 전 3년 중 해외에서 임원 또는 관리자로 연속 1년 근무했으며, 청원 승인 후 1년 이내 미국 사무소가 임원 또는 관리자 직위를 뒷받침할 수 있어야 한다.",
        "source_ids": ["USCIS-L1A"],
        "review_status": "needs_review"
    },
    {
        "policy_id": "L1-12",
        "topic": "l1b_new_office_requirements",
        "visa_classifications": ["L-1B"],
        "applicant_type": "specialized_knowledge_employee",
        "sufficient_physical_premises_required": true,
        "financial_ability_to_compensate_employee_required": true,
        "financial_ability_to_begin_business_required": true,
        "summary_ko": "L-1B 신규 사무소 설립 시 충분한 물리적 사무 공간과 직원에게 급여를 지급하고 미국에서 사업을 시작할 수 있는 재정적 능력을 입증해야 한다.",
        "source_ids": ["USCIS-L1B"],
        "review_status": "needs_review"
    },
    {
        "policy_id": "L1-13",
        "topic": "l1b_third_party_worksite_restrictions",
        "visa_classifications": ["L-1B"],
        "applicant_type": "specialized_knowledge_employee",
        "applies_when": "principally_stationed_at_unaffiliated_employer_worksite",
        "principally_controlled_by_unaffiliated_employer_allowed": false,
        "labor_for_hire_to_unaffiliated_employer_allowed": false,
        "both_restrictions_must_be_satisfied": true,
        "third_party_worksite_automatically_disqualifies": false,
        "summary_ko": "L-1B 직원이 청원 고용주 또는 그 적격 관계사가 아닌 기업의 사업장에서 주로 근무하는 경우, 비계열 기업이 해당 직원을 주로 감독·통제해서는 안 되며 업무가 해당 기업에 대한 단순 인력 공급이어서는 안 된다. 두 조건을 모두 충족해야 한다.",
        "source_ids": ["USCIS-L1B"],
        "review_status": "needs_review"
    },
    {
        "policy_id": "L1-14",
        "topic": "l2_family_dependents",
        "visa_classifications": ["L-1A", "L-1B"],
        "dependent_classification": "L-2",
        "eligible_relationships": [
            "spouse",
            "unmarried_child_under_21"
        ],
        "child_maximum_age_exclusive": 21,
        "dependent_stay_generally_same_as_principal": true,
        "form_i539_for_change_or_extension": true,
        "summary_ko": "L-1A 또는 L-1B 주신청자의 배우자와 21세 미만 미혼 자녀는 L-2 신분을 신청할 수 있으며, 승인 시 일반적으로 주신청자와 동일한 체류기간을 부여받는다. 미국 내 신분 변경 또는 체류기간 연장은 Form I-539를 통해 신청할 수 있다.",
        "source_ids": ["USCIS-L1A", "USCIS-L1B"],
        "review_status": "needs_review"
    },
    {
        "policy_id": "L1-15",
        "topic": "l2_spouse_employment_authorization",
        "visa_classifications": ["L-1A", "L-1B"],
        "applicant_type": "dependent_spouse",
        "dependent_classification": "L-2S",
        "employment_authorized_incident_to_status": true,
        "separate_ead_generally_required": false,
        "unexpired_l2s_i94_accepted_as_i9_list_c_evidence": true,
        "historical_l2_i94_notice_exception_exists": true,
        "employment_authorization_not_automatically_extended_to_children": true,
        "summary_ko": "유효한 L-2S 신분의 배우자는 신분 자체에 따라 취업이 허용된다. 유효한 L-2S 표기 I-94는 Form I-9의 List C 증빙으로 사용할 수 있다. 과거 L-2 표기 I-94와 USCIS 통지서를 함께 사용하는 경우도 있으며, 이 규정을 자녀에게 자동 적용해서는 안 된다.",
        "source_ids": ["USCIS-L1A", "USCIS-L1B"],
        "review_status": "needs_review"
    }, 
