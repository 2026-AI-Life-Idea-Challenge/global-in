    },
    {
      "policy_id": "E2-14",
      "topic": "e2_spouse_employment_authorization",
      "applicant_type": "dependent_spouse",
      "summary_ko": "유효한 E-2 또는 E-2S 신분의 배우자는 원칙적으로 신분 자체에 따라 취업이 허용된다. 다만 CNMI 장기 투자자 배우자 등 예외가 존재하며 취업허가 증빙 요건을 별도로 확인해야 한다.",
      "employment_authorized_incident_to_status": true,
