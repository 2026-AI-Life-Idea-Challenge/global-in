# 백엔드(FastAPI) 환경변수. 로컬은 이 파일을 .env로 복사하고, 배포 시에는 호스팅 대시보드에 입력한다.

# 정책 DB (PostgreSQL 17 + pgvector)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# 상담 세션 저장소. 비우면 컨테이너 로컬 sqlite를 써서 재배포 때 세션이 사라진다.
# 정책 DB와 같은 DB를 써도 된다 (consult_runtime 스키마를 따로 사용). Neon이면 pooler가 아닌 direct 주소를 쓴다.
CONSULT_SESSION_DATABASE_URL=

# 프론트엔드의 INTERNAL_API_KEY와 같은 값. 예: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

OPENAI_API_KEY=

# Langfuse 트레이싱(선택). 두 키가 모두 있을 때만 켜진다. Langfuse 프로젝트 Settings → API Keys에서 발급.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # US 리전이면 https://us.cloud.langfuse.com

# 선택 설정
# CONSULT_MAX_CONCURRENT=4
# CONSULT_REQUEST_TIMEOUT=100
